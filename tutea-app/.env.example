# Supabase → Project Settings → Database → Connection string → ORMs.
# La "pooled" (puerto 6543) para consultar y la "direct" (puerto 5432) para
# migrar. NO usar SQLite: en Vercel el disco es efímero y de solo lectura.
DATABASE_URL="postgresql://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Clave única de administrador, compartida por gerencia.
ADMIN_PASSWORD="cambiar-esta-clave"

# Secreto para firmar la cookie de sesión.
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiar-este-secreto"
