# Supabase → Project Settings → Database → Connection string → ORMs.
# La "pooled" (puerto 6543) para consultar y la "direct" (puerto 5432) para
# migrar. NO usar SQLite: en Vercel el disco es efímero y de solo lectura.
#
# connection_limit=5 (no 1): el pooler de Supabase (Supavisor/pgbouncer) ya
# multiplexa las conexiones, así que esto no abre 5 conexiones reales por
# instancia. Con 1, cada carga de página hacía fila: el layout busca los
# cumpleaños del día y la página pide sus propios datos, y con una sola
# conexión disponible esas dos consultas no podían correr en paralelo.
DATABASE_URL="postgresql://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
DIRECT_URL="postgresql://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Clave única de administrador, compartida por gerencia.
ADMIN_PASSWORD="cambiar-esta-clave"

# Secreto para firmar la cookie de sesión.
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiar-este-secreto"
