// Sistema de Gestión de Colaboradores — Tutea
// Modelo de datos según la especificación (§3 del spec).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase: la pooled para consultar, la directa para migrar.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Area {
  operativo
  comercial
  administrativo
  marketing
  gerencia
}

/// Motivo de un permiso, para pintar el corazón distinto según la razón.
enum TipoVida {
  general
  medico
  desastre
  /// Permiso que la persona repone trabajando otro día: no es un día
  /// perdido, así que se distingue de un permiso general.
  recuperable
  /// Vida usada para no marcar una tardanza como falta.
  tardanza
}

/// Estado de un evento del calendario; define su color en la vista mensual.
enum EstadoEvento {
  pendiente
  en_desarrollo
  finalizado
}

enum DiaSemana {
  lunes
  martes
  miercoles
  jueves
  viernes
  sabado
}

/// Colaborador. Se usa soft delete (`activo`) para no romper el historial.
model Collaborator {
  id                     String   @id @default(uuid())
  nombre                 String
  area                   Area
  /// Data URL base64 de la foto, ya redimensionada a 400x400 en el navegador.
  foto                   String?  @db.Text
  /// Fecha completa: día, mes y año. El día es necesario para el módulo de
  /// cumpleaños; el año permite calcular la edad.
  ///
  /// Opcional: la planilla real del equipo no la tiene para todos, y una fecha
  /// inventada dispararía un cumpleaños falso.
  fechaNacimiento        DateTime? @map("fecha_nacimiento") @db.Date
  /// Cupo por defecto con el que se abre cada mes. El cupo realmente vigente
  /// vive en LifeMonthlyPeriod.
  vidasMensualesDefault  Int      @default(2) @map("vidas_mensuales_default")
  /// Inicio y fin del contrato vigente. Tutea recontrata por tramos (6 meses,
  /// 1 año...), así que esto no es "cuándo entró a la empresa" sino el
  /// contrato actual: cada vez que se renueva, se actualizan estas dos
  /// fechas y el contrato anterior queda archivado en VacationPeriod (nunca
  /// se pierde, es el historial de toda su relación con la empresa).
  ///
  /// De acá sale el cupo de vacaciones (§ Vacaciones): 7 días hábiles cada 6
  /// meses de contrato, 14 cada año, proporcional para otras duraciones.
  /// Opcionales por lo mismo que la fecha de nacimiento: la planilla real no
  /// las trae para todos, e inventarlas abriría un período con fechas y un
  /// cupo falsos.
  fechaInicioContrato    DateTime? @map("fecha_inicio_contrato") @db.Date
  fechaFinContrato       DateTime? @map("fecha_fin_contrato") @db.Date
  activo                 Boolean  @default(true)
  creadoEn               DateTime @default(now()) @map("creado_en")
  actualizadoEn          DateTime @updatedAt @map("actualizado_en")

  bloques           ScheduleBlock[]
  historial         ScheduleHistory[]
  periodos          LifeMonthlyPeriod[]
  usos              LifeUsage[]
  periodosVacacion  VacationPeriod[]
  vacaciones        VacationUsage[]

  @@index([activo])
  @@map("collaborators")
}

/// Horario vigente. No guarda versiones: al editar se reemplazan los bloques y
/// la versión anterior queda como snapshot en ScheduleHistory.
model ScheduleBlock {
  id             String    @id @default(uuid())
  colaboradorId  String    @map("colaborador_id")
  diaSemana      DiaSemana @map("dia_semana")
  /// Minutos desde medianoche (0–1440), hora local de Lima. Entero en vez de
  /// `time` para comparar y detectar solapamientos sin líos de zona horaria.
  horaInicioMin  Int       @map("hora_inicio_min")
  horaFinMin     Int       @map("hora_fin_min")

  colaborador Collaborator @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@index([colaboradorId, diaSemana])
  @@map("schedule_blocks")
}

/// Snapshot completo del horario antes y después de cada cambio.
model ScheduleHistory {
  id               String   @id @default(uuid())
  colaboradorId    String   @map("colaborador_id")
  fechaCambio      DateTime @default(now()) @map("fecha_cambio")
  horarioAnterior  Json     @map("horario_anterior")
  horarioNuevo     Json     @map("horario_nuevo")

  colaborador Collaborator @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@index([colaboradorId, fechaCambio])
  @@map("schedule_history")
}

/// Período mensual de vidas. `cerradoEn = null` significa período en curso.
///
/// Puede haber MÁS DE UN período para el mismo mes: un reinicio manual a mitad
/// de mes cierra el vigente —que queda archivado con sus usos— y abre uno
/// nuevo. Lo que sí es único es el período abierto por colaborador, garantizado
/// con un índice único parcial (ver la migración habilitar_reinicio_manual);
/// Prisma no sabe expresar índices parciales, por eso vive en SQL.
model LifeMonthlyPeriod {
  id              String    @id @default(uuid())
  colaboradorId   String    @map("colaborador_id")
  /// Formato invariante YYYY-MM, calculado en zona horaria America/Lima.
  mesPeriodo      String    @map("mes_periodo") @db.VarChar(7)
  vidasAsignadas  Int       @map("vidas_asignadas")
  abiertoEn       DateTime  @default(now()) @map("abierto_en")
  cerradoEn       DateTime? @map("cerrado_en")

  colaborador Collaborator @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  usos        LifeUsage[]

  @@index([colaboradorId, mesPeriodo])
  @@index([mesPeriodo])
  @@map("life_monthly_periods")
}

/// Uso de una vida (permiso). Si no queda cupo se registra igual y se marca
/// como excedido al presentarlo; nunca se bloquea el registro.
model LifeUsage {
  id             String   @id @default(uuid())
  colaboradorId  String   @map("colaborador_id")
  periodoId      String   @map("periodo_id")
  fecha          DateTime @db.Date
  /// Dato sensible: no se expone nunca en la vista pública.
  motivo         String
  /// Descanso médico y desastre natural pintan el corazón distinto; el resto
  /// queda como "general".
  tipo           TipoVida @default(general)
  registradoEn   DateTime @default(now()) @map("registrado_en")

  colaborador Collaborator      @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  periodo     LifeMonthlyPeriod @relation(fields: [periodoId], references: [id], onDelete: Cascade)

  @@index([periodoId])
  @@index([colaboradorId, fecha])
  @@map("life_usages")
}

/// Un contrato, con el cupo de vacaciones que le correspondió. `cerradoEn =
/// null` significa el contrato vigente; los cerrados son el historial
/// completo de todos los contratos que tuvo la persona en la empresa —se
/// crea uno nuevo cada vez que `Collaborator.fechaInicioContrato`/
/// `fechaFinContrato` cambian a un rango distinto— y no se recalculan ni se
/// borran nunca, aunque después cambie la fórmula de días por duración.
///
/// Al cerrarse, el saldo que quedó sin usar se pierde: no se arrastra al
/// contrato siguiente.
model VacationPeriod {
  id             String    @id @default(uuid())
  colaboradorId  String    @map("colaborador_id")
  /// Inicio del contrato (= fechaInicioContrato en el momento en que se creó
  /// este período).
  desde          DateTime  @map("desde") @db.Date
  /// Fin del contrato (= fechaFinContrato en ese momento).
  hasta          DateTime  @map("hasta") @db.Date
  diasAsignados  Int       @map("dias_asignados")
  abiertoEn      DateTime  @default(now()) @map("abierto_en")
  cerradoEn      DateTime? @map("cerrado_en")

  colaborador Collaborator    @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  usos        VacationUsage[]

  @@index([colaboradorId])
  @@map("vacation_periods")
}

/// Un goce de vacaciones: un rango de fechas ya tomado. `dias` se guarda como
/// número fijo al registrarlo —no se recalcula desde fechaInicio/fechaFin—
/// para que un cambio futuro en la regla de conteo no reescriba en silencio
/// lo que ya se aprobó.
model VacationUsage {
  id             String   @id @default(uuid())
  colaboradorId  String   @map("colaborador_id")
  periodoId      String   @map("periodo_id")
  fechaInicio    DateTime @map("fecha_inicio") @db.Date
  fechaFin       DateTime @map("fecha_fin") @db.Date
  dias           Int
  /// Nota opcional de gerencia (motivo, si fue adelanto, etc.). A diferencia
  /// del motivo de Vidas, esto no es un dato sensible: sí se muestra en la
  /// vista pública.
  observacion    String?  @db.Text
  registradoEn   DateTime @default(now()) @map("registrado_en")

  colaborador Collaborator   @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  periodo     VacationPeriod @relation(fields: [periodoId], references: [id], onDelete: Cascade)

  @@index([periodoId])
  @@index([colaboradorId, fechaInicio])
  @@map("vacation_usages")
}

/// Para qué sirve un documento: las políticas (RIT, MOF) se leen en el
/// navegador; los modelos (solicitud de vacaciones, carta de renuncia) se
/// descargan para completarlos.
enum CategoriaDocumento {
  politica
  modelo
}

/// Documento de la empresa para todo el equipo. El archivo se guarda dentro
/// de la propia base (igual que las fotos), sin servicio de archivos aparte:
/// son pocos documentos y livianos. El tope de tamaño lo fija la acción que
/// los sube, no la base.
model Documento {
  id            String             @id @default(uuid())
  titulo        String
  descripcion   String?            @db.Text
  categoria     CategoriaDocumento
  nombreArchivo String             @map("nombre_archivo")
  tipoMime      String             @map("tipo_mime")
  tamanoBytes   Int                @map("tamano_bytes")
  contenido     Bytes
  creadoEn      DateTime           @default(now()) @map("creado_en")
  actualizadoEn DateTime           @updatedAt @map("actualizado_en")

  @@index([categoria])
  @@map("documentos")
}

/// Evento del calendario de la empresa (feriados, campañas, hitos). No está
/// ligado a un colaborador: es de la empresa, no de una persona.
model CalendarEvent {
  id            String       @id @default(uuid())
  titulo        String
  descripcion   String?      @db.Text
  fecha         DateTime     @db.Date
  estado        EstadoEvento @default(pendiente)
  creadoEn      DateTime     @default(now()) @map("creado_en")
  actualizadoEn DateTime     @updatedAt @map("actualizado_en")

  @@index([fecha])
  @@map("calendar_events")
}
